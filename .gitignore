.obsidian/workspace-mobile.json
.obsidian/workspace*.json
.obsidian/cache
.trash/

# Smart Connections 임베딩 (로컬 재생성)
.smart-env/
.smart-connections/

# OS / 에디터
.DS_Store
Thumbs.db
*.swp

# 비밀정보는 절대 커밋하지 않음
.env
*.pem
*.key

# Plugin data with OAuth tokens/API keys (per-user)
.obsidian/plugins/smart-composer/data.json
# Bundled plugin code with vendor OAuth client values (install via Obsidian)
.obsidian/plugins/remotely-save/main.js
.obsidian/plugins/smart-composer/main.js
